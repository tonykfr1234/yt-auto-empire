# ==============================================================================
# YT-Auto-Empire 環境設定檔 (.env.example -> 請複製為 .env 並填入金鑰)
# ==============================================================================

# 1. Gemini API Key (必填：用於腳本企劃、Gemini Omni 1.2 影片生成、3.8 TTS 配音、Nano Banana 縮圖)
GEMINI_API_KEY="your_gemini_api_key_here"

# 2. 選品目標地區與語言 (預設台灣 TW / 美國 US)
TREND_GEO="TW"
TREND_LANG="zh-TW"
NICHE_KEYWORDS="3C神器,智慧家電,AI工具,居家好物,廚房神器"

# 3. 雙引擎影片生成與 Google One AI Ultra 點數榨乾設定
# 模式可選: "ultra" (推薦：優先 100% 消耗 Google Flow Ultra 點數，滿載後自動無縫接軌 API)
# 其他模式: "flow" (純 Google Flow 網頁), "api" (純 Gemini Omni 1.2 API), "hybrid" (混合)
VIDEO_ENGINE_MODE="ultra"
VIDEO_RESOLUTION="1080p"
CHROME_USER_DATA_DIR="./chrome_profile"

# Google One AI Ultra 月度點數配額設定 (確保每月歸零前 100% 消耗完畢)
ULTRA_MONTHLY_CREDITS="15000"
CREDITS_PER_FLOW_CLIP="20"
ULTRA_RESET_DAY="1"

# 4. 聯盟行銷與變現連結設定 (自動插入 YouTube 說明欄與置頂留言)
AFFILIATE_STORE_URL="https://shopee.tw/your_affiliate_shop"
AMAZON_AFFILIATE_TAG="yourtag-20"
SPONSOR_CONTACT_EMAIL="business@yourdomain.com"

# 5. YouTube Data API v3 認證檔路徑與上傳預設值
YOUTUBE_CLIENT_SECRETS_FILE="client_secrets.json"
YOUTUBE_PRIVACY_STATUS="public"  # 可選: public, unlisted, private

# 6. 上傳用的 YouTube 帳號（只存在你自己的 .env，不要寫進程式碼）
YOUTUBE_CHANNEL_EMAIL="you@example.com"
